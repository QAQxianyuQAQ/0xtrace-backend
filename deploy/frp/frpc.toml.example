# TraceQuest 内网 frpc 示例：所有对外模块均由本机 frpc 主动穿透。
# MySQL 和 Redis 只在内部 Docker 网络使用，禁止为本机 3306/6379 创建 proxy。
# 请将 serverAddr、serverPort、认证信息和域名替换为实际部署值。
serverAddr = "frp.example.com"
serverPort = 443
auth.method = "token"
auth.token = "<replace-with-frp-token>"

# 公网 443：题目容器 WSS
[[proxies]]
name = "tracequest-wss"
type = "https"
localIP = "127.0.0.1"
localPort = 8080
customDomains = ["tq.example.com"]

# 公网 8080：REST API
[[proxies]]
name = "tracequest-rest"
type = "tcp"
localIP = "127.0.0.1"
localPort = 8080
remotePort = 8080

# 公网 9000：MinIO S3 API 与预签名下载
[[proxies]]
name = "tracequest-minio-api"
type = "tcp"
localIP = "127.0.0.1"
localPort = 9000
remotePort = 9000

# 公网 9001：MinIO 控制台，可按需删除或在 frps 限制来源 IP
[[proxies]]
name = "tracequest-minio-console"
type = "tcp"
localIP = "127.0.0.1"
localPort = 9001
remotePort = 9001
