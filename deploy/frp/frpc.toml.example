# TraceQuest 内网 frpc 示例：443 专用于选手到内网题目容器的 WSS 转发。
# REST API 与 MinIO 使用各自的公网端口，不经过这个 frp 代理。
# 请将 serverAddr、serverPort、认证信息和域名替换为实际部署值。
serverAddr = "frp.example.com"
serverPort = 443
auth.method = "token"
auth.token = "<replace-with-frp-token>"

# 该域名在公网 443 上只用于题目容器 WebSocket；应用后端仍可单独开放 8080 提供 REST
[[proxies]]
name = "tracequest-wss"
type = "https"
localIP = "127.0.0.1"
localPort = 8080
customDomains = ["tq.example.com"]

# 如需严格限制只有 WebSocket 路径可达，请在 8080 前增加路径级反向代理。
