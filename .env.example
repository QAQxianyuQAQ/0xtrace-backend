# 本地/部署环境变量样例：复制为 .env 后填入真实值（.env 已在 .gitignore 中忽略）
# 严禁把填写后的 .env 提交到版本库。

# 数据库
TQ_DB_HOST=localhost
TQ_DB_PORT=3306
TQ_DB_NAME=tracequest
TQ_DB_USERNAME=tracequest
TQ_DB_PASSWORD=

# Redis
TQ_REDIS_HOST=localhost
TQ_REDIS_PORT=6379
TQ_REDIS_PASSWORD=

# MinIO 对象存储
TQ_MINIO_ENDPOINT=http://localhost:9000
TQ_MINIO_ACCESS_KEY=
TQ_MINIO_SECRET_KEY=
TQ_MINIO_BUCKET=tracequest

# 应用密钥：请使用 openssl rand -base64 48 生成
TQ_JWT_SECRET=
TQ_ANSWER_SECRET=

# 会话 Cookie（生产必须为 true）
TQ_COOKIE_SECURE=true
TQ_ENFORCE_SAME_ORIGIN=true
TQ_STRICT_SECRET_CHECK=true

# 初始化数据装配：生产必须为 false
TQ_BOOTSTRAP_ENABLED=false
TQ_ADMIN_USERNAME=
TQ_ADMIN_PASSWORD=

# 赛事默认配置
TQ_EVENT_NAME=TraceQuest Season 01
TQ_EVENT_TIMEZONE=Asia/Shanghai
