# TraceQuest 后端 Docker 部署变量模板
#
# 用法：cp .env.deploy.example .env，再把 <...> 占位符替换为真实值。
# 约定：
#   - .env 已被 .gitignore 忽略，请勿提交；仓库内不保存任何真实凭据。
#   - 生成随机密钥：openssl rand -base64 48
#   - 完整步骤见 DEPLOY.md。

# ---------- 镜像与端口 ----------
# 本地构建出的镜像名，与 docker-compose.yml 中 app.image 对应
TQ_IMAGE=tracequest-backend:1.0.0
# REST API 对公网提供的独立端口（443 专用于题目容器 WSS）
TQ_SERVER_PORT=8080
# Docker Socket 所属组 ID，可在宿主机执行 stat -c '%g' /var/run/docker.sock 获取
TQ_DOCKER_GID=999

# ---------- 运行模式 ----------
# 运行 profile 留空即可：生产强校验由 TQ_STRICT_SECRET_CHECK 显式控制。
# 首次启动需要自动创建管理员：把 TQ_BOOTSTRAP_ENABLED 临时改为 true、TQ_STRICT_SECRET_CHECK 改为 false，
# 创建完成后务必改回 false / true 并重启 app 容器。
SPRING_PROFILES_ACTIVE=
TQ_BOOTSTRAP_ENABLED=false
# 生产强校验：开启后密钥缺失/过弱、或初始化装配仍为 true，都会直接拒绝启动
TQ_STRICT_SECRET_CHECK=true

# ---------- MySQL ----------
# 使用 docker-compose.yml（自带中间件）时留空即可，默认走容器服务名 mysql/redis；
# 使用 docker-compose.app-only.yml（复用已有中间件）时必须填写对方地址，详见 DEPLOY.md 第 12 节
TQ_DB_HOST=
TQ_DB_PORT=3306
TQ_DB_NAME=tracequest
TQ_DB_USERNAME=tracequest
# 应用账号口令（≥16 位随机值）
TQ_DB_PASSWORD=
# root 口令：仅用于初始化与备份，容器不向宿主机发布端口
TQ_DB_ROOT_PASSWORD=

# ---------- Redis ----------
TQ_REDIS_HOST=
TQ_REDIS_PORT=6379
TQ_REDIS_PASSWORD=

# ---------- MinIO ----------
# 注意：该地址同时用于生成文件预签名下载链接，必须是浏览器能直接访问的地址。
# MinIO 可直接通过独立公网端口访问，例如 http://<服务器IP>:9000
TQ_MINIO_ENDPOINT=http://<服务器IP>:9000
TQ_MINIO_ACCESS_KEY=
TQ_MINIO_SECRET_KEY=
TQ_MINIO_BUCKET=tracequest
TQ_MINIO_API_PORT=9000
TQ_MINIO_CONSOLE_PORT=9001

# ---------- 应用密钥（openssl rand -base64 48 生成，建议 ≥32 字节） ----------
TQ_JWT_SECRET=
TQ_ANSWER_SECRET=

# ---------- 会话 Cookie 与来源校验 ----------
# 纯 HTTP 演示环境必须为 false；接入 HTTPS 后改回 true
TQ_COOKIE_SECURE=false
# 写请求同源校验：前后端同域部署时保持 true；前端独立域名时用 ALLOWED_ORIGINS 加白名单
TQ_ENFORCE_SAME_ORIGIN=true
# 跨域前端白名单（可选，逗号分隔，例如 http://192.168.1.10:5173）
TRACEQUEST_SECURITY_ALLOWED_ORIGINS=

# ---------- 单机 Docker 题目运行时 ----------
TQ_RUNTIME_ENABLED=true
TQ_RUNTIME_NETWORK=tracequest-runtime
# 443 专用于 frp 将选手 WSS 连接转发到内网题目容器网关
TQ_PUBLIC_WSS_URL=wss://tq.example.com/api/v1/challenge-connections
TQ_RUNTIME_MEMORY_LIMIT=512m
TQ_RUNTIME_CPU_LIMIT=1.0
TQ_RUNTIME_PIDS_LIMIT=256
TQ_RUNTIME_START_TIMEOUT=60s
TQ_RUNTIME_COMMAND_TIMEOUT=5m
TQ_RUNTIME_INSTANCE_TTL=1h
TQ_RUNTIME_EXTENSION_DURATION=1h
TQ_RUNTIME_EXTENSION_WINDOW=30m
TQ_RUNTIME_CLEANUP_INTERVAL=30s
TQ_CONNECTION_TICKET_TTL=60s
TQ_WEBSOCKET_IDLE_TIMEOUT=5m

# ---------- 管理员账号 ----------
# 即使关闭初始化装配，生产强校验也会检查该口令，请填写 ≥16 位强口令
TQ_ADMIN_USERNAME=admin
TQ_ADMIN_PASSWORD=

# ---------- 赛事默认值（仅初始化装配时生效） ----------
TQ_EVENT_NAME=TraceQuest Season 01
TQ_EVENT_TIMEZONE=Asia/Shanghai
